# Frontend environment variables (example)
# Copy to .env.local for local development (do not commit secrets).

# Base path prefix used by the frontend HTTP client. In dev, Vite proxies this path.
VITE_API_BASE_PATH=/api

# Vite dev server proxy target (Shopizer Modern gateway defaults to 8081).
VITE_DEV_API_PROXY_TARGET=http://localhost:8081

# Shopizer Modern: merchant store UUID required by catalog endpoints such as
# GET /api/v1/catalog/stores/{storeId}/categories
#
# If omitted, the UI will use the deterministic MVP seed store UUID by default
# (see shopizer-modern-java21/docs/how-to-find-store-uuid.md).
#
# You can still override this in real deployments/migrations:
# VITE_DEFAULT_STORE_ID=<uuid>
VITE_DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001

# Optional: Dev bearer token for secured endpoints (e.g. modern order-service).
# If provided, the UI will include it as an Authorization header ("Bearer ...") and reflect auth state in the header/account pages.
# VITE_DEV_BEARER_TOKEN=<jwt>
